        "trend_annual": "data/data-cleaned/google-trends/trend_annual.parquet",
        "trend_keywords": "data/data-cleaned/google-trends/trend_keywords.parquet"
      },
      "fetch_scripts": {
        "trends_crawler": {
          "entrypoint": "scripts-fetching/unit-scripts/get_trends.py",
          "enabled": false
        }
      }
    },
    "data_paths": {
      "cdf_output": "data/data-cleaned/v3/cdf_deduplicated.parquet",
      "features_output": "data/data-cleaned/v3/gold_deduplicated.parquet",
      "models_dir": "models/",
      "report_output": "reports/evaluation_temporal.md"
    },
    "quality_gate": {
      "max_rmse": 0.16,
      "min_r2": 0.78,
      "max_bayes_gap_mse": null
    },
    "reliability": {
      "retry_policy": {
        "max_attempts": 3,
        "initial_backoff_sec": 2,
        "backoff_multiplier": 2.0
      }
    }
  },
